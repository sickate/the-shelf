{
  "name": "the-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app:upload": "node --env-file-if-exists=.env scripts/mvp-upload.mjs",
    "app:enrich": "node --env-file-if-exists=.env scripts/mvp-enrich.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/export-docs.mjs && astro build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "deploy:cloudflare": "node scripts/cf-deploy.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "docs:export": "node scripts/export-docs.mjs",
    "import:books": "python3 scripts/import-books.py",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify:public": "node --env-file-if-exists=.env scripts/verify-public.mjs",
    "upload:plan": "node --env-file-if-exists=.env server/upload.mjs",
    "cf:probe": "node scripts/cf-probe.mjs",
    "deploy:cloudflare:api": "node scripts/cf-api-deploy.mjs",
    "cf:init": "node scripts/cf-api-init.mjs",
    "cf:library": "node scripts/cf-library.mjs",
    "build:cloudflare:api": "SHELF_CF_API_MODE=same-origin node scripts/build-cloudflare.mjs",
    "test:metadata:browser": "node scripts/metadata-browser-fixture.mjs",
    "prepare:text": "node scripts/prepare-text.mjs",
    "text:select": "node scripts/select-text.mjs",
    "app:test": "node --test tests/mvp-*.test.mjs",
    "app:dev": "node app/build.mjs && wrangler dev -c app/wrangler.jsonc",
    "app:deploy": "node app/build.mjs && wrangler deploy -c app/wrangler.jsonc"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "epubjs": "0.3.93",
    "foliate-js": "1.0.1",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.0-beta",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "wrangler": "4.151.0"
  }
}
