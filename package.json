{
  "name": "the-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/export-docs.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "docs:export": "node scripts/export-docs.mjs",
    "import:books": "python3 scripts/import-books.py",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify:public": "node --env-file-if-exists=.env scripts/verify-public.mjs",
    "upload:plan": "node --env-file-if-exists=.env server/upload.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "epubjs": "0.3.93",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  }
}
