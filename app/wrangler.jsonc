{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "the-shelf",
  "main": "entry.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "the-shelf-app", "database_id": "ae7d29ac-aa2c-4ff7-9af1-6c43a70e7ee3" }
  ],
  "r2_buckets": [
    { "binding": "BOOKS", "bucket_name": "the-shelf-first-book-20261023" }
  ],
  // Read-aloud (A1): one Workflow instance per audio job part (<jobId>-p<n>).
  // Class AudioWorkflow is exported from entry.mjs; logic in worker.mjs runAudioWorkflow.
  "workflows": [
    { "name": "the-shelf-audio", "binding": "AUDIO_WORKFLOW", "class_name": "AudioWorkflow" }
  ],
  // B1 (2026-10-28): an instance never creates its continuation (nested creation hit the subrequest
  // depth limit); it records audio_jobs.next_part and this cron (worker.mjs scheduled → audioCron)
  // or a job GET starts it. Workers Free: 5 Cron Triggers per account, 10 ms CPU per run.
  "triggers": { "crons": ["* * * * *"] }
  // Secrets (wrangler secret put): SESSION_SECRET, OAI_KEY (AI book info),
  // DEEPSEEK_KEY (optional web search for AI book info; skipped when unset).
  // Google sign-in (G1, docs/mvp-plan.md 2026-10-27): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // OWNER_EMAILS (comma separated whitelist); OWNER_API_TOKEN (>= 32 chars, Bearer for scripts).
  // Read-aloud (A1, 2026-10-27): DASHSCOPE_KEY (the-shelf DashScope key, Beijing region). New jobs use
  // qwen-audio-3.1-tts-flash (inference WebSocket, 2026-10-28); jobs created before 0008 keep
  // qwen3-tts-flash-realtime. Without the key or the AUDIO_WORKFLOW binding, creating audio returns 503.
  // LLM text cleanup reuses OAI_KEY (falls back to rule-based cleanup when unset).
  // Optional var TTS_MODEL: another qwen-audio-* model for new jobs (other names are ignored).
  // G2 (2026-10-27): password login removed; delete the leftover OWNER_PASSWORD secret (wrangler secret delete).
  // Optional vars: OAI_BASE_URL (default https://oai.parallelstreamllc.com),
  // GOOGLE_REDIRECT_URI (default <origin>/api/auth/google/callback).
  // Schema migrations: app/migrations/0002_features.sql (covers, book_info),
  // app/migrations/0003_classification.sql (book_class), ... app/migrations/0007_audio.sql (read-aloud), 0008_audio_tts.sql (TTS model/tone/marks), 0009_audio_handoff.sql (continuation hand-off). CLC table app/clc.json is bundled.
}
