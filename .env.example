# Frontend values are public; never put a secret in a PUBLIC_ variable.
PUBLIC_SHELF_API_MODE=
PUBLIC_SHELF_API_URL=
SHELF_SITE_URL=http://localhost:4321
SHELF_BASE_PATH=/
ASTRO_TELEMETRY_DISABLED=1

# Backend values stay on the server. Set a unique password before login.
SHELF_HOST=127.0.0.1
SHELF_PORT=8787
SHELF_OWNER_PASSWORD=
SHELF_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
SHELF_COOKIE_SECURE=false
SHELF_STATE_DIR=.local
SHELF_CATALOG_PATH=data/catalog.json
SHELF_MANIFEST_PATH=.local/manifest.json
SHELF_LOCAL_FILES_ENABLED=false

# Existing /v1/tasks service; leave unset to disable AI calls.
SHELF_OAI_BASE_URL=
SHELF_OAI_KEY=
SHELF_AI_DAILY_CALL_LIMIT=20
SHELF_AI_JOB_CALL_LIMIT=12
SHELF_AI_TIMEOUT_MS=900000
SHELF_QUEUE_LIMIT=30

# R2 remains optional. Upload CLI is dry-run unless --execute is passed.
SHELF_R2_ACCOUNT_ID=
SHELF_R2_BUCKET=
SHELF_R2_ACCESS_KEY_ID=
SHELF_R2_SECRET_ACCESS_KEY=
SHELF_STORAGE_BUDGET_BYTES=8000000000
SHELF_R2_EXISTING_BYTES=0
SHELF_R2_DAILY_ACCESS=1000
